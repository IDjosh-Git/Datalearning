# Set values in Vercel Project Settings → Environment Variables (server-side).
# Do not put real keys in this file, repository, browser code or ZIP archives.
TUTOR_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Alternative (requires setting TUTOR_PROVIDER=openai):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# DALP_AUTH_URL=
# DALP_AUTH_PUBLISHABLE_KEY=
