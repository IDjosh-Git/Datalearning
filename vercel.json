{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(),microphone=(),geolocation=()"
        }
      ]
    },
    {
      "source": "/courses/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(scripts|styles)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(auth|account|profile|admin|reviewer|progress|capstone|certificate|verify|practice).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(scripts|styles)/(admin-dashboard|admin-console|progress-admin|reviewer)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(connection-test|sync-test).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/overview",
      "destination": "/overview.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/practice",
      "destination": "/practice.html"
    },
    {
      "source": "/courses/:course",
      "destination": "/courses/:course.html"
    }
  ],
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/courses/introduction-roadmap.html",
      "destination": "/courses/introduction.html",
      "permanent": false
    },
    {
      "source": "/courses/introduction-extension.html",
      "destination": "/courses/introduction.html",
      "permanent": false
    },
    {
      "source": "/courses/excel-roadmap.html",
      "destination": "/courses/excel.html",
      "permanent": false
    },
    {
      "source": "/courses/excel-extension.html",
      "destination": "/courses/excel.html",
      "permanent": false
    },
    {
      "source": "/courses/sql-roadmap.html",
      "destination": "/courses/sql.html",
      "permanent": false
    },
    {
      "source": "/courses/sql-extension.html",
      "destination": "/courses/sql.html",
      "permanent": false
    },
    {
      "source": "/courses/powerbi-roadmap.html",
      "destination": "/courses/powerbi.html",
      "permanent": false
    },
    {
      "source": "/courses/powerbi-extension.html",
      "destination": "/courses/powerbi.html",
      "permanent": false
    }
  ]
}
